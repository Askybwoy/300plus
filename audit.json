    {
      "name": "Парсинг аудита",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 0],
      "parameters": { "mode": "runOnceForAllItems", "jsCode": "const r=$input.first().json;const txt=r.content[0].text;let a;try{a=JSON.parse(txt);}catch(e){const m=txt.match(/\\{[\\s\\S]*\\}/);a=m?JSON.parse(m[0]):{overall_score:0,hypotheses:[]};}const f=$('Парсинг данных').first().json;const pe={'высокий':'🔴','средний':'🟡','низкий':'🟢'};const hyps=(a.hypotheses||[]).map((h,i)=>'('+(i+1)+') <b>'+h.title+'</b>\\n⚠️ '+h.problem+'\\n💡 '+h.solution+'\\n📈 '+h.potential_cr+'  '+(pe[h.priority]||'🔴')+' '+h.priority).join('\\n\\n');const clientMsg='✅ <b>Аудит готов, '+f.name+'!</b>\\n\\n🌐 '+f.projectUrl+'\\n⭐️ Оценка: <b>'+a.overall_score+'/10</b>\\n\\n📋 <b>5 гипотез:</b>\\n\\n'+hyps+'\\n\\n───────────────\\n🚀 <b>Реализуем вместе?</b>\\n\\n• Старт — 15 000 ₽ · 2 дня\\n• Спринт — 99 000 ₽ · 7 дней ⭐\\n• Полный запуск — 300 000 ₽ · 10 дней\\n\\nНапишите <b>Хочу обсудить</b>!';const ownerMsg='🔔 <b>Новый аудит!</b>\\n\\n👤 '+f.name+'\\n📱 '+f.contact+'\\n🌐 '+f.projectUrl+'\\n⭐️ '+a.overall_score+'/10\\n\\n'+(a.hypotheses||[]).slice(0,3).map((h,i)=>(i+1)+'. '+h.title+' ('+h.priority+')').join('\\n')+'\\n\\nОтправить клиенту?';return[{json:{...f,overallScore:a.overall_score,hypotheses:a.hypotheses||[],clientMsg,ownerMsg}}];" }
    },
    {
      "name": "Одобрение владельца",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1200, 0],
      "parameters": { "resource": "message", "operation": "sendAndWait", "chatId": "75402056", "message": "={{ $json.ownerMsg }}", "responseType": "approval", "approvalOptions": { "values": { "approvalType": "double", "approveLabel": "✅ Отправить клиенту", "disapproveLabel": "❌ Отложить" } }, "options": { "appendAttribution": false, "limitWaitTime": { "values": { "limitType": "afterTimeInterval", "resumeAmount": 24, "resumeUnit": "hours" } } } }
